[run]
branch = True
source = app
omit =
    tests/*
    */venv/*
    */.venv/*
    */__pycache__/*
    */site-packages/*

[report]
show_missing = True
skip_covered = False
fail_under = 90.0
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:

[html]
directory = htmlcov
