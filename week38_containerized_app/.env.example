# =========================================================================
# Docker Pulse Environment Configuration Template
# Copy this file to .env before starting Docker Compose
# =========================================================================

FLASK_ENV=production
PORT=5000
HOST=0.0.0.0
SECRET_KEY=dev-secret-key-change-in-production
# In production environments, the system can load secrets from Docker Secrets or a file path:
# SECRET_KEY_FILE=/run/secrets/api_secret_key

# PostgreSQL Configuration & Persistence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=docker_pulse_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/docker_pulse_db

# Redis Configuration & Persistence
REDIS_PORT=6379
REDIS_URL=redis://cache:6379/0
CACHE_DEFAULT_TTL=300

# Reverse Proxy Configuration
WEB_PORT=8080

# Overrides and Production Profiles
# Development mode automatically merges docker-compose.override.yml for hot-reloading.
# Production mode applies resource limits and secrets via docker-compose.prod.yml:
# docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
